# ============================================
# 1. SETUP LIBSTDC++ LOKAL (GLIBCXX_3.4.29)
# ============================================
echo "[INFO] Memeriksa libstdc++ di ~/lib64..."

if [ ! -f "$HOME/lib64/libstdc++.so.6" ] || ! strings "$HOME/lib64/libstdc++.so.6" 2>/dev/null | grep -q "GLIBCXX_3.4.29"; then
    echo "[INFO] GLIBCXX_3.4.29 tidak ditemukan, menginstall..."

    mkdir -p ~/lib64
    cd ~

    # Download libstdc++
    echo "[INFO] Download libstdc++..."
    wget -q -O libstdc++.deb http://archive.ubuntu.com/ubuntu/pool/main/g/gcc-12/libstdc++6_12-20220319-1ubuntu1_amd64.deb

    # Ekstrak .deb
    ar x libstdc++.deb

    # Cek format kompresi (zst atau xz)
    if [ -f "data.tar.zst" ]; then
        echo "[INFO] Format zst detected, installing zstd..."
        if ! command -v zstd &> /dev/null; then
            echo "[INFO] Download zstd..."
            wget -q https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz
            tar -xvzf zstd-1.5.7.tar.gz > /dev/null 2>&1
            cd zstd-1.5.7
            make -j$(nproc) > /dev/null 2>&1
            mkdir -p ~/bin
            cp programs/zstd ~/bin/
            export PATH="$HOME/bin:$PATH"
            cd ~
        fi
        zstd -d data.tar.zst
        tar -xf data.tar
    elif [ -f "data.tar.xz" ]; then
        tar -xf data.tar.xz
    else
        echo "❌ Format data tidak dikenal!"
        exit 1
    fi

    # Copy library
    cp -f usr/lib/x86_64-linux-gnu/libstdc++.so.6* ~/lib64/
    echo "[INFO] ✅ libstdc++ terinstall di ~/lib64"
fi

